# Use the official Bun image as the base
FROM oven/bun:1.2.8-alpine

# Set the working directory inside the container
WORKDIR /app

# Copy package.json and bun.lockb (if it exists) for dependency installation
COPY package.json bun.lock ./

# Install dependencies using Bun
RUN bun install

# Set the environment variable for Vite to listen on all interfaces (0.0.0.0)
ENV VITE_HOST=0.0.0.0

# Expose the default Vite development server port (5173)
EXPOSE 5173

# Start the development server with Bun
CMD ["bun", "run", "dev"]